# DashScope-compatible API
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# Shared generation connection for /chat, routing and /research.
# Restart after changes. Embeddings are configured separately.
# DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com, MODEL_NAME=deepseek-flash,
# and DEEPSEEK_API_KEY. Missing provider key never falls back to an Alibaba key.
OPENAI_BASE_URL=
MODEL_NAME=
DEEPSEEK_API_KEY=
# Optional connection overrides (also used by legacy chat)
RESEARCH_BASE_URL=
RESEARCH_MODEL_NAME=
RESEARCH_API_KEY=

# Local deep-research experiment endpoint (generate a random 32+ character value)
DEEP_RESEARCH_API_TOKEN=
# Conservative character guard for the current 64K-input-token model snapshot.
# It is not an exact tokenizer; validate again when changing model or corpus language.
ADAPTIVE_FULL_CONTEXT_MAX_CHARS=100000
# One advisory check after a paper answer; never rewrites it. Set 0 to disable.
RESEARCH_QUALITY_REVIEW=1
DEEP_RESEARCH_MAX_REQUESTS_PER_HOUR=4
DEEP_RESEARCH_MAX_TOKENS_PER_DAY=150000
DEEP_RESEARCH_TOKEN_RESERVATION=50000
DEEP_RESEARCH_MAX_CONCURRENT=1

# Alibaba Cloud STS and OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=
OSS_ROLE_ARN=
OSS_BUCKET=
OSS_ENDPOINT=
